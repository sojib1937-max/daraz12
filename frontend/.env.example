# DesertCart frontend — public-safe variables only (VITE_ prefix).
# Copy to .env.local and adjust if needed. NEVER put secrets here —
# the browser can read anything in this file.

# Admin panel route base (must match backend ADMIN_BASE_PATH)
VITE_ADMIN_PATH=/admin

# Dev/preview proxy target for /api and /uploads
VITE_API_TARGET=http://127.0.0.1:4000
