# ============================================================
# DesertCart — Backend environment (development defaults)
# Copy to .env and adjust. NEVER commit real secrets.
# See ENVIRONMENT.md for the full reference.
# ============================================================

NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://neondb_owner:npg_kXNrQW7pCYG0@ep-withered-glitter-az9wq08e.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Server ---
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Admin ---
ADMIN_BASE_PATH=/admin

# --- Security ---
# IMPORTANT: generate a long random value for production:
#   openssl rand -hex 64
SESSION_SECRET=dev-session-secret-change-me-in-production
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
ADMIN_SESSION_DAYS=3
CUSTOMER_SESSION_DAYS=30
RESET_TOKEN_MINUTES=30

# --- Demo mode ---
# true  => seed/demo data is clearly labelled "demo" everywhere; social proof
#          popups show demo orders with a DEMO badge.
# false => production: only real database orders generate sales notifications.
DEMO_MODE=true

# --- Seed admin (created by npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@desertcart.ae
SEED_ADMIN_PASSWORD=Admin@12345

# --- Media storage (local | s3) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_BASE_URL=/uploads
UPLOAD_MAX_MB=8
# S3-compatible (only needed when STORAGE_DRIVER=s3):
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# --- Email (console | smtp) ---
EMAIL_DRIVER=console
EMAIL_FROM=DesertCart <no-reply@desertcart.ae>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- SMS (console | http webhook e.g. Twilio) ---
SMS_DRIVER=console
# SMS_WEBHOOK_URL=
# SMS_API_KEY=
# SMS_FROM=DesertCart

# --- WhatsApp (console | http webhook e.g. WhatsApp Business API) ---
WHATSAPP_DRIVER=console
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_API_KEY=

# --- Analytics (public-safe IDs injected into the storefront <head>) ---
ANALYTICS_GA_ID=
ANALYTICS_META_PIXEL_ID=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_ORDER_MAX=10

# --- Fraud detection defaults (also editable in Admin → Settings) ---
FRAUD_DUPLICATE_WINDOW_HOURS=6
FRAUD_DUPLICATE_MAX_ORDERS=2
